# Copy to a secure local environment only. Never commit real values.
# Do not paste credentials into chat.

# Exact Trafft API origin shown by the Trafft API setup card.
TRAFFT_API_URL=https://your-trafft-host.example

# Trafft's published Postman collection uses /api/v2 for token and data requests.
TRAFFT_API_PATH=/api/v2

# Authentication endpoint relative to TRAFFT_API_PATH.
TRAFFT_AUTH_PATH=/token

# Comma-separated exact hostnames permitted to receive Trafft credentials.
TRAFFT_ALLOWED_HOSTS=your-trafft-host.example

TRAFFT_CLIENT_ID=replace_in_secure_secret_store
TRAFFT_CLIENT_SECRET=replace_in_secure_secret_store

# Required for durable, privacy-minimized operation logs.
TRAFFT_AUDIT_LOG_PATH=.audit/trafft-readonly.jsonl

# Safety defaults.
TRAFFT_TIMEOUT_MS=30000
TRAFFT_MAX_HTTP_BODY_BYTES=5000000
TRAFFT_MAX_RESPONSE_CHARS=20000
TRAFFT_MAX_RETRIES=2

# Unverified endpoints stay disabled until a controlled live read-only probe.
TRAFFT_ENABLE_EXPERIMENTAL_READS=false
