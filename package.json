{
  "name": "@mad-logic-studio/trafft-mcp-readonly",
  "version": "0.2.0",
  "private": true,
  "description": "Hardened community read-only MCP server for auditing a Trafft account.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node build/index.js",
    "test": "npm run check",
    "test:core": "bash scripts/test-core.sh && node scripts/policy-check.mjs && tsc -p tsconfig.syntax.json",
    "test:protocol": "node --test test/mcp-smoke.test.mjs",
    "test:live-harness": "node --test test/live-validation.test.mjs",
    "test:live-config": "node --test test/live-config-preflight.test.mjs",
    "test:live-diagnostic": "node --test test/live-response-diagnostic.test.mjs",
    "check": "npm run test:core && npm run build && npm run test:protocol && npm run test:live-harness && npm run test:live-config && npm run test:live-diagnostic",
    "validate:preflight": "node scripts/preflight-live-config.mjs",
    "validate:diagnostic": "node build/live-response-diagnostic.js",
    "validate:live": "node build/live-validation.js",
    "validate:audit": "node scripts/check-live-audit.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "inspector": "npx --yes @modelcontextprotocol/inspector@0.16.8 build/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "dotenv": "17.4.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "typescript": "6.0.3"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "UPSTREAM.md",
    "config"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mad-Logic-Studio/trafft-mcp-readonly.git"
  },
  "homepage": "https://github.com/Mad-Logic-Studio/trafft-mcp-readonly#readme",
  "bugs": {
    "url": "https://github.com/Mad-Logic-Studio/trafft-mcp-readonly/issues"
  }
}
